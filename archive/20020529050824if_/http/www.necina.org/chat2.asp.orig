</td><td rowspan="2" bgcolor="999999" width="1"></td><td rowspan="2" width="25"><br></td><td width="444"></td></tr><tr>
    <td valign="top" align="center"> 
      <form method="post" action="chat/chatroom.asp" name="" onsubmit="window.open('','chatroom','width=770,height=500 Status=yes,scrollbars=yes,resizable=YES,top=0, left=0')" target="chatroom">
        <br>
        <b>CHATROOM</b>
        <br><br>
        <table border="0" width="355" height="123">
          <tr> 
            <td valign="middle" align="left" width="385" height="6" colspan="3"><b>Just enter your name.           
              Only privileged user needs to log in.</b></td> 
          </tr>
          <tr>
            <td valign="middle" align="left" width="126" height="25">Name:</td>
            <td valign="middle" width="175" height="25"><font color="#FFFF00"> 
              <input type="text" name="Name" size="16" style="background-color: #FFFFFF; color: #000000; border: 1 solid #000000" value="" maxlength="10"></font></td>
            <td valign="middle" width="84" height="25"><input type="submit" value="  GO  " name="Enter" style="background-color: #FFFFFF; color: #000000; border: 1 solid #000000">
            </td>
          </tr>
          <tr> 
            <td valign="middle" align="left" width="126" height="11">Password:</td>
            <td valign="middle" width="175" height="11"><font color="#FFCCFF"> 
              <input type="password" name="password" size="16" style="background-color: #FFFFFF; color: #000000; border: 1 solid #000000" maxlength="10">
              </font></td>
            <td valign="middle" width="84" height="11"></td>
          </tr>
          <tr> 
            <td valign="middle" align="left" width="126" height="18"> Gender:</td>
            <td valign="middle" width="261" height="18" colspan="2"> 
              <input type="radio" name="sex" value="   " checked> Hide <input type="radio" name="sex" value="?ив "> 
              Male <input type="radio" name="sex" value="?? ">
              Female </td>
          </tr>
          <td rowspan="2" width="126">Font Size: 
          <tr> 
            <td width="261" colspan="2"> 
              <input type="radio" value="yes" checked name="screen">
              Small 
              <input type="radio" value="False" name="screen">
              Big </td>
          </tr>
        </table>                  
<hr width="350" size="1">
</form>                      
<table border="0" width="77%" cellspacing="0" cellpadding="0" height="227">
        <tr>
          <td width="100%" height="171">        
          Easy instructions:<br>          
            a) To chat with your friends, just invite them to enter <br><img border="0" src="/web/20020804061304im_/http://www.necina.org/images/bbb.gif" width="11" height="2"> the Chat           
            Room.<br>
            b) Type in the dialog box and you friends will see it.<br>          
            c) Have fun!<br>          
            <br>
            Please note:<br>          
            a) The maximum number of participants is 50.<br>          
            b) The maximum number of English characters in dialog box <br><img border="0" src="/web/20020804061304im_/http://www.necina.org/images/bbb.gif" width="11" height="2"> is 160 and           
            80 for Chinese characters.</td>          
        </tr>
        <tr>
          <td width="100%" align="center" height="56"><img src="/web/20020804061304im_/http://www.necina.org/chat/images/logo.jpg"></td> 
        </tr>
      </table>
                      
    </td>
  </tr></table>
